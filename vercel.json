{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"api/preview.js": { "includeFiles": "src/content/projects/**" }
	},
	"rewrites": [
		{ "source": "/yap", "destination": "/yap/index.html" },
		{ "source": "/yap/:id", "destination": "/yap/:id/index.html" },
		{ "source": "/projects", "destination": "/projects/index.html" },
		{ "source": "/projects/:id", "destination": "/projects/:id/index.html" }
	]
}
